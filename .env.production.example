# Copy to .env.production; chmod 600 .env.production. Never commit the filled file.
# Use the full 40-character SHA of a successfully published GitHub build.
IMAGE_TAG=
IMAGE_REPOSITORY=ghcr.io/saitwors/campus-flow
APP_ORIGIN=https://mcg-mtuci.ru
COOKIE_SECURE=true
HTTP_PORT=8080

# Generate DIFFERENT URL-safe passwords (at least 32 characters).
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
SCHEDULE_DB_PASSWORD=
QUEUE_DB_PASSWORD=
NOTIFICATIONS_DB_PASSWORD=

# When migrating, copy these two values from your existing .env unchanged.
INTERNAL_TOKEN=
SETUP_KEY=

# The VAPID key pair lives in the notifications DB and is included in backups.
PUSH_ENABLED=true
VAPID_SUBJECT=https://mcg-mtuci.ru

# The small-server profile always disables the local translator.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
