# Generate real values using START_WINDOWS.cmd or bash scripts/start.sh.
APP_ORIGIN=http://localhost:8080
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
INTERNAL_TOKEN=
SETUP_KEY=
AUTH_DB_PASSWORD=
SCHEDULE_DB_PASSWORD=
QUEUE_DB_PASSWORD=

NOTIFICATIONS_DB_PASSWORD=
# HTTPS APP_ORIGIN enables push. Optional real operator contact:
PUSH_ENABLED=true
VAPID_SUBJECT=
# Lightweight by default. Enable both to run the private RU -> EN model:
COMPOSE_PROFILES=
TRANSLATION_WORKER=false
